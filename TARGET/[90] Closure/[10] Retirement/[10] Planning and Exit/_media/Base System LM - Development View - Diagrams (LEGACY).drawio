        <mxCell id="jVVNQGUuFgy5CzWm82x2-32" value="&lt;font style=&quot;font-size: 12px&quot;&gt;Diagram: Base System Logical Module - Development - Classes - &lt;br&gt;Organisation Members Permissions&lt;/font&gt;" style="text;strokeColor=none;fillColor=none;html=1;fontSize=12;fontStyle=2;verticalAlign=middle;align=left;shadow=0;glass=0;comic=0;opacity=30;fontColor=#808080;" parent="jVVNQGUuFgy5CzWm82x2-1" vertex="1">
