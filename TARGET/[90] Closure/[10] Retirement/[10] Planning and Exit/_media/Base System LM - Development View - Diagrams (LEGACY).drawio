        <mxCell id="Qz7827VAV9bLty-unmsl-0" value="&lt;font style=&quot;font-size: 12px&quot;&gt;Diagram: Information - Principle Information Areas&lt;/font&gt;" style="text;strokeColor=none;fillColor=none;html=1;fontSize=12;fontStyle=2;verticalAlign=middle;align=left;shadow=0;glass=0;comic=0;opacity=30;fontColor=#808080;" parent="vcGz2X3xdQekcJThql-k-27" vertex="1">
          <mxGeometry x="120" y="850" width="440" height="20" as="geometry" />
        </mxCell>
