          <mxGeometry x="120" y="120" width="560" height="45" as="geometry" />
        </mxCell>
        <mxCell id="arTIJLTiI9J5-0zWeaxv-1" value="&lt;font style=&quot;font-size: 12px&quot;&gt;Base Logical Module -&amp;nbsp;Deployment - Considerations&lt;/font&gt;" style="text;strokeColor=none;fillColor=none;html=1;fontSize=24;fontStyle=1;verticalAlign=middle;align=left;shadow=0;glass=0;comic=0;opacity=30;fontColor=#808080;" parent="arTIJLTiI9J5-0zWeaxv-0" vertex="1">
          <mxGeometry width="560" height="40" as="geometry" />
