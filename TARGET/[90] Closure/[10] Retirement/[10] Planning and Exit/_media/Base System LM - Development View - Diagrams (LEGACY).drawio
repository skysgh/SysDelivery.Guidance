        <mxCell id="Ku8i4R_OYWpHUvpAigGd-1" value="&lt;font style=&quot;font-size: 12px&quot;&gt;Diagram: Base System Logical Module -&amp;nbsp;Functionality -&amp;nbsp;Functionality Groups - High Level&lt;/font&gt;" style="text;strokeColor=none;fillColor=none;html=1;fontSize=12;fontStyle=2;verticalAlign=middle;align=left;shadow=0;glass=0;comic=0;opacity=30;fontColor=#808080;strokeWidth=1;" parent="Ku8i4R_OYWpHUvpAigGd-0" vertex="1">
