          </mxGeometry>
        </mxCell>
        <mxCell id="H-o9jr5U-qMhc_zled-7-317" value="trusts" style="edgeStyle=none;rounded=0;jumpStyle=none;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.25;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=1;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;fontColor=#006600;" parent="q97PAu7SrpwxUYGlZQ9h-1" source="H-o9jr5U-qMhc_zled-7-250" target="H-o9jr5U-qMhc_zled-7-262" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="323" y="925" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ETrmQhY8hsjyk3ig5ivT-4" value="Notes" parent="q97PAu7SrpwxUYGlZQ9h-0" />
        <mxCell id="H-o9jr5U-qMhc_zled-7-284" value="&lt;p style=&quot;line-height: 100%&quot;&gt;Quasi-Permanent merges of directory services trees are notably complex to set up/take down.&amp;nbsp;&lt;br&gt;&lt;span&gt;One org takes the lead on managing the merged DS. Other orgs may chaff at the centralized control.&lt;br&gt;&lt;/span&gt;Resources belong to the Conglomerate members.&lt;/p&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-16;rounded=0;labelBackgroundColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fillColor=none;strokeColor=#666666;fontColor=#333333;spacingRight=8;" parent="ETrmQhY8hsjyk3ig5ivT-4" vertex="1">
          <mxGeometry x="590" y="690" width="130" height="100" as="geometry" />
        </mxCell>
        <mxCell id="H-o9jr5U-qMhc_zled-7-285" value="&lt;p style=&quot;line-height: 100%&quot;&gt;Enterprises generally use their own IdP, and optionally reuse their LAN based Directory Service (DS) to provision system member roles.&lt;br style=&quot;font-size: 11px&quot;&gt;&lt;br&gt;&lt;/p&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-16;rounded=0;labelBackgroundColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fillColor=none;strokeColor=#666666;fontColor=#333333;spacingRight=8;" parent="ETrmQhY8hsjyk3ig5ivT-4" vertex="1">
          <mxGeometry x="590" y="460" width="130" height="100" as="geometry" />
        </mxCell>
        <mxCell id="H-o9jr5U-qMhc_zled-7-318" value="&lt;p style=&quot;line-height: 90%&quot;&gt;&lt;i&gt;Note: it&#39;s very rare that Orgs can allow users from different Orgs. &lt;/i&gt;&lt;i&gt;This means not being able to temporarily add Partner org members (as individuals, at best). Nor SSO for them.&lt;br&gt;Resources belong to the Org.&lt;/i&gt;&lt;/p&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-16;rounded=0;labelBackgroundColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;spacingRight=10;opacity=30;" parent="ETrmQhY8hsjyk3ig5ivT-4" vertex="1">
          <mxGeometry x="590" y="580" width="130" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ETrmQhY8hsjyk3ig5ivT-0" value="&lt;p style=&quot;line-height: 100%&quot;&gt;Resources belong to groups rather than directly to the individuals members of the group.&lt;br&gt;&lt;br&gt;Any user in the system can be invited into a group to view its resources.&amp;nbsp;&lt;/p&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-16;rounded=0;labelBackgroundColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fillColor=none;strokeColor=#666666;fontColor=#333333;spacingRight=8;" parent="ETrmQhY8hsjyk3ig5ivT-4" vertex="1">
          <mxGeometry x="590" y="290" width="130" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ETrmQhY8hsjyk3ig5ivT-1" value="&lt;p style=&quot;line-height: 100%&quot;&gt;Simple systems manage resources for individuals.&amp;nbsp; Such systems &lt;i&gt;might&lt;/i&gt; allow users to share their resources for &lt;u&gt;simple&lt;/u&gt; collaboration with other specific system user.&lt;/p&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-16;rounded=0;labelBackgroundColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=11;fillColor=none;strokeColor=#666666;fontColor=#333333;spacingRight=8;" parent="ETrmQhY8hsjyk3ig5ivT-4" vertex="1">
          <mxGeometry x="590" y="180" width="130" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ETrmQhY8hsjyk3ig5ivT-5" value="&lt;p style=&quot;line-height: 100%&quot;&gt;Resources belong to the temporary project partnership - of which one or more users &amp;amp; orgs are members. Orgs are less of a resources store than a source pool of skilled and trusted partner workforce.&lt;br&gt;&lt;/p&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-16;rounded=0;labelBackgroundColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fillColor=none;strokeColor=#666666;fontColor=#333333;spacingRight=8;" parent="ETrmQhY8hsjyk3ig5ivT-4" vertex="1">
          <mxGeometry x="590" y="810" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ETrmQhY8hsjyk3ig5ivT-6" value="&lt;p style=&quot;line-height: 100%&quot;&gt;&lt;span&gt;More dynamic &amp;amp; adaptable to current flexible collaborative conditions (partners, consultants, franchisees, suppliers, interested parties, etc.)&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-16;rounded=0;labelBackgroundColor=none;strokeWidth=1;fontFamily=Helvetica;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;spacingRight=8;" parent="ETrmQhY8hsjyk3ig5ivT-4" vertex="1">
          <mxGeometry x="590" y="900" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="NB94KmSjhQeGn2sv6NBi-4" value="Title/Diagram" parent="q97PAu7SrpwxUYGlZQ9h-0" />
        <mxCell id="IAx6Ck_aqqKJ6aW92HLM-0" value="Diagram: Resource Authorisation&amp;nbsp;Boundary Comparison" style="text;html=1;fontSize=11;fontColor=#000000;fontStyle=2" parent="NB94KmSjhQeGn2sv6NBi-4" vertex="1">
          <mxGeometry x="120" y="940" width="470" height="20" as="geometry" />
        </mxCell>
        <mxCell id="NB94KmSjhQeGn2sv6NBi-6" value="About" parent="q97PAu7SrpwxUYGlZQ9h-0" />
      </root>
    </mxGraphModel>
  </diagram>
