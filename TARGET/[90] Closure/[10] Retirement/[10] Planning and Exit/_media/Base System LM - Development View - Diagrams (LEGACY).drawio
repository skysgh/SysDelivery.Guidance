        <mxCell id="bYuXZJ5ob_-7N1gs0lVh-30" value="ToC generally cover Behaviour while using system (respect, bullying, use of copyright, etc.).&lt;br&gt;This is a appropriate time to ensure Users have accepted Tracking, Data Use ToCs." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;labelBackgroundColor=none;fillColor=#ffffff;fontSize=11;spacingLeft=0;spacingRight=12;" parent="v7naMWOq-BcuSidbaf_q-1" vertex="1">
