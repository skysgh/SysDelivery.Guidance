          <mxGeometry x="520" y="420" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="BdFhdWTU9qY8VHg69Mt0-43" value="Metadata can be used to encode the compile date (eg: + 201901031103) generally in first place (metadata values are separated by &#39;.&#39;).&lt;br&gt;&lt;br&gt;Do NOT use Major, Minor, Patch, PreRelease Tag values to encode project tracking/release information (eg: GoLive is NOT 1.0.0....). &lt;br&gt;Metadata can be used for that kind of stuff: +{compiledate}.golive&amp;nbsp;&lt;br&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;strokeColor=#000000;fillColor=none;fontSize=12;" parent="BdFhdWTU9qY8VHg69Mt0-1" vertex="1">
