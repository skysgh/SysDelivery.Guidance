          <mxGeometry x="440" y="540" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mYWp_UlOXr_x5S5TBlAo-16" value="&lt;b&gt;Organisation Group&lt;/b&gt; Roles, Obligations &amp;amp; Permissions" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;strokeColor=#6c8ebf;strokeWidth=1;fillColor=#dae8fc;fontSize=12;align=center;" parent="mYWp_UlOXr_x5S5TBlAo-1" vertex="1">
          <mxGeometry x="560" y="540" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mYWp_UlOXr_x5S5TBlAo-17" value="&lt;b&gt;Resource&lt;/b&gt; &lt;b&gt;Roles&lt;/b&gt;, Obligations &amp;amp; Permissions" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;strokeColor=#d79b00;strokeWidth=1;fillColor=#ffe6cc;fontSize=12;align=center;" parent="mYWp_UlOXr_x5S5TBlAo-1" vertex="1">
          <mxGeometry x="560" y="640" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mYWp_UlOXr_x5S5TBlAo-18" value="&lt;b&gt;Project&amp;nbsp; &amp;amp; Ad-hoc Group&amp;nbsp;&lt;/b&gt;Roles, Obligations &amp;amp; Permissions" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;strokeColor=#82b366;strokeWidth=3;fillColor=#d5e8d4;fontSize=12;align=center;" parent="mYWp_UlOXr_x5S5TBlAo-1" vertex="1">
          <mxGeometry x="440" y="640" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mYWp_UlOXr_x5S5TBlAo-19" value="Organisation Groups generally mirrors enterprise internal&amp;nbsp;nested&lt;br&gt;business unit silo&#39;ed architecture" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;strokeColor=#000000;strokeWidth=1;fillColor=none;gradientColor=#FAFAFA;fontSize=12;fontColor=#000000;" parent="mYWp_UlOXr_x5S5TBlAo-1" vertex="1">
          <mxGeometry x="680" y="540" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="mYWp_UlOXr_x5S5TBlAo-20" value="Fine Grain control over every document, but too onerous an effort to be practical on a daily basis. Hence not common." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;strokeColor=#000000;strokeWidth=1;fillColor=none;gradientColor=#FAFAFA;fontSize=12;fontColor=#000000;" parent="mYWp_UlOXr_x5S5TBlAo-1" vertex="1">
          <mxGeometry x="680" y="660" width="100" height="260" as="geometry" />
        </mxCell>
        <mxCell id="mYWp_UlOXr_x5S5TBlAo-21" value="Allows projects to be collaborated on from different organisations as well as invited public users.&lt;br&gt;&lt;br&gt;Not common in enterprise software, but expected to become more prevalent with GenX part-time project based workforce habits." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;strokeColor=#000000;strokeWidth=1;fillColor=none;gradientColor=#FAFAFA;fontSize=12;fontColor=#000000;" parent="mYWp_UlOXr_x5S5TBlAo-1" vertex="1">
          <mxGeometry x="300" y="655" width="100" height="230" as="geometry" />
        </mxCell>
        <mxCell id="mYWp_UlOXr_x5S5TBlAo-23" value="Protects documents, but often at the cost of limiting access by collaborators." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;strokeColor=#000000;strokeWidth=1;fillColor=none;gradientColor=#FAFAFA;fontSize=12;fontColor=#000000;" parent="mYWp_UlOXr_x5S5TBlAo-1" vertex="1">
          <mxGeometry x="300" y="540" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="mYWp_UlOXr_x5S5TBlAo-24" value="&lt;i&gt;System wide Roles&lt;/i&gt;&amp;nbsp;are required to differentiate between&amp;nbsp; anonymous consumer users and authenticated system users (belonging to zero or more organisations), and other non-org users, including &quot;super-user&quot; system admins, customer support specialists, operations specialists and security specialists." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;strokeColor=#000000;strokeWidth=1;fillColor=none;gradientColor=#FAFAFA;fontSize=12;fontColor=#000000;" parent="mYWp_UlOXr_x5S5TBlAo-1" vertex="1">
          <mxGeometry x="120" y="960" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="mYWp_UlOXr_x5S5TBlAo-28" value="Text" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;fontSize=12;fontColor=#000000;" parent="mYWp_UlOXr_x5S5TBlAo-24" vertex="1">
          <mxGeometry x="89" y="9" width="40" height="20" as="geometry" />
        </mxCell>
