  <diagram name="Development/Development Patterns/Anti" id="Y2YBssNfOzk73P9EHqiF">
    <mxGraphModel dx="1388" dy="534" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-0" />
        <mxCell id="I80WKypt0ZiV3r7D1_aT-1" value="Diagram" parent="I80WKypt0ZiV3r7D1_aT-0" />
        <mxCell id="I80WKypt0ZiV3r7D1_aT-21" value="APIs" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;glass=0;comic=0;strokeColor=#666666;fillColor=#f5f5f5;fontSize=12;align=center;fontColor=#333333;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="120" y="399" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-23" value="Entities used as DTOs" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1;fillColor=none;fontSize=12;fontColor=#333333;align=center;labelBackgroundColor=none;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="210" y="399" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-41" value="Entities" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;glass=0;comic=0;strokeColor=#666666;fillColor=#f5f5f5;fontSize=12;align=center;fontColor=#333333;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="120" y="770" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-42" value="Objects with Save() (etc.) methods&amp;nbsp;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1;fillColor=none;fontSize=12;fontColor=#333333;align=center;labelBackgroundColor=none;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="210" y="820" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-43" value="Component Design" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;glass=0;comic=0;strokeColor=#666666;fillColor=#f5f5f5;fontSize=12;align=center;fontColor=#333333;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="120" y="530" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-44" value="Not using Domain Driven Design" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1;fillColor=none;fontSize=12;fontColor=#333333;align=center;labelBackgroundColor=none;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="210" y="530" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-45" value="Testing" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;glass=0;comic=0;strokeColor=#666666;fillColor=#f5f5f5;fontSize=12;align=center;fontColor=#333333;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="120" y="180" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-46" value="Test Scripts and development in parrallel" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1;fillColor=none;fontSize=12;fontColor=#333333;align=center;labelBackgroundColor=none;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="210" y="180" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-47" value="Security: unecessarily exposes storage schema, and/or too many attribute values." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;fillColor=none;fontSize=12;spacingRight=16;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="310" y="399" width="370" height="30" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-48" value="Interoperability: removes option to handle versioning cost-effectively, decreases security. Use best practice Mapping." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;fillColor=none;fontSize=12;spacingRight=16;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="310" y="439" width="370" height="30" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-49" value="Maintainability: all but trivial internal systems benefit from separation of domains (tech/business)." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;fillColor=none;fontSize=12;spacingRight=16;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="310" y="530" width="370" height="30" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-50" value="Correctness: being able to concentrate on one domain at a time diminishes inaccuracies in code." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;fillColor=none;fontSize=12;spacingRight=16;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="310" y="570" width="370" height="30" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-51" value="Testability: being able to concentrate on one domain at a time diminishes complexity of test harnesses to prove correctness." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;fillColor=none;fontSize=12;spacingRight=16;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="310" y="610" width="370" height="30" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-52" value="Security &amp;amp; Maintainability: DSL languages are domain specific. Use Interoperability DSL for DTOs only. Use ORM schemas for developing entities.&amp;nbsp;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;fillColor=none;fontSize=12;spacingRight=16;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="310" y="770" width="370" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-55" value="Test scripts must be developed from User Story before dev starts. Development should be to meet tests, not user stories, at the risk of two interpretations of the desired outcome, failed tests, delays.&amp;nbsp;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;fillColor=none;fontSize=12;spacingRight=16;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="310" y="180" width="370" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-56" value="Security" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;glass=0;comic=0;strokeColor=#666666;fillColor=#f5f5f5;fontSize=12;align=center;fontColor=#333333;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="120" y="230" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-57" value="Delaying dev of security to after business logic." style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1;fillColor=none;fontSize=12;fontColor=#333333;align=center;labelBackgroundColor=none;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="210" y="230" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-58" value="Security: no product can be accredited to go live for any users -- internal or public -- without sessions, authentication, authorisation, auditing, accountability. Much harder to add afterwards.&amp;nbsp;&amp;nbsp;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;fillColor=none;fontSize=12;spacingRight=16;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="310" y="230" width="370" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-60" value="Internal Authentication" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1;fillColor=none;fontSize=12;fontColor=#333333;align=center;labelBackgroundColor=none;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="210" y="280" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-61" value="Security &amp;amp; Reputation: keeping passwords in the system is so 90&#39;s. And ripe for hacking by agents who are far better at it than you are at defending PII &amp;amp; Secrets. Use an external IdP ONLY." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;fillColor=none;fontSize=12;spacingRight=16;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="310" y="280" width="370" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-62" value="External Authorisation" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1;fillColor=none;fontSize=12;fontColor=#333333;align=center;labelBackgroundColor=none;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="210" y="330" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-63" value="Security: using an external service to manage roles (eg: AD group membership) is so 90&#39;s, and flawed thinking. A central dependency + incomplete information system costs far more to run (FTE &amp;amp; opportunities lost) than development cost saved." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;fillColor=none;fontSize=12;spacingRight=16;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="310" y="330" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-64" value="Develop Client UI on Server&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;(eg: ASP.NET MVC)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1;fillColor=none;fontSize=12;fontColor=#333333;align=center;labelBackgroundColor=none;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="210" y="650" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-65" value="Developing client pages on servers uses servers CPU, rather than client CPU, costing more to handle less concurrent users." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;fillColor=none;fontSize=12;spacingRight=16;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="310" y="650" width="370" height="30" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-66" value="The opportunity to save time in the short term by avoiding API development, adds integration &amp;amp; maintainability costs later.&amp;nbsp;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;fillColor=none;fontSize=12;spacingRight=16;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="310" y="690" width="370" height="30" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-68" value="OO" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;glass=0;comic=0;strokeColor=#666666;fillColor=#f5f5f5;fontSize=12;align=center;fontColor=#333333;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="120" y="820" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-69" value="System Entities from API schemas" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1;fillColor=none;fontSize=12;fontColor=#333333;align=center;labelBackgroundColor=none;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="210" y="770" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-71" value="Active Record and similar are anti-patterns in that they don&#39;t abide by OO patterns. Object Methods should modify themselves only. Services are used to modify multiple objects, or pass the Object to a 3rd party service (eg: DB handler service)." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;fillColor=none;fontSize=12;spacingRight=16;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="310" y="820" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-72" value="Using new()" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1;fillColor=none;fontSize=12;fontColor=#333333;align=center;labelBackgroundColor=none;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="210" y="890" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-73" value="&amp;nbsp;All but the most trivial systems primarily use entities that benefit from being built. Maintainable apps do not use new() -- they use Factories&amp;nbsp; Or better yet, use Injection, as per SOLID design patterns." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;fillColor=none;fontSize=12;spacingRight=16;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="310" y="890" width="370" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-74" value="Maintainability: Service Systems are distinct from Client Systems, even if they share the same Protocol.&amp;nbsp;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;fillColor=none;fontSize=12;spacingRight=16;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="310" y="730" width="370" height="30" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-75" value="Systems thrive from user expressed desire. Defining a Handler early to transparently handle Versioning allows for non-disruption to service clients when these changes are made.&amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;fillColor=none;fontSize=12;spacingRight=16;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="310" y="480" width="370" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-76" value="Delaying implementing versioning&amp;nbsp;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1;fillColor=none;fontSize=12;fontColor=#333333;align=center;labelBackgroundColor=none;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="210" y="480" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-79" value="DB" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;glass=0;comic=0;strokeColor=#666666;fillColor=#f5f5f5;fontSize=12;align=center;fontColor=#333333;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="120" y="940" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-80" value="Using INT indexes" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#666666;strokeWidth=1;fillColor=none;fontSize=12;fontColor=#333333;align=center;labelBackgroundColor=none;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="210" y="940" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I80WKypt0ZiV3r7D1_aT-81" value="Only UUIDs can be synced across devices (client, mobiles, server).&lt;br&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;fillColor=none;fontSize=12;spacingRight=16;" parent="I80WKypt0ZiV3r7D1_aT-1" vertex="1">
          <mxGeometry x="310" y="940" width="370" height="20" as="geometry" />
        </mxCell>
