        <mxCell id="VbAhHB3cUUnG_AeQq9Lp-5" value="Implies the following Capabilities and features:" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];;autosize=1;fontSize=12;fontStyle=1" parent="HlPzL88gKnD_90cnEyZ7-4" vertex="1">
