        <mxCell id="07n0lLYkODwOQFyNEO4c-10" parent="YOU5BtBW--oNC1GvZMYw-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;i&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Note:&lt;br&gt;&lt;/font&gt;&lt;/i&gt;&lt;div style=&quot;&quot;&gt;&lt;i&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;The brokering of 3rd party dependencies&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;behind application specific services - in one place - is &lt;u&gt;intentional&lt;/u&gt;.&amp;nbsp;&lt;br&gt;It protects the rest of the app from &quot;version rot&quot; while providing a single place to address&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/i&gt;&lt;i style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;3rd party &lt;/font&gt;&lt;/i&gt;&lt;i style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;updates out of the applications&#39;s control.&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="150" x="410" y="500" as="geometry" />
        </mxCell>
